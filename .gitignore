# Export / build artifacts
#################################################

export_presets.cfg
export.cfg

# Android build outputs (if exporting Android)
android/

#################################################
# Mono / C# (only if you're using C#)
#################################################

.mono/
data_*/
mono_crash.*.json

#################################################
# OS junk files
#################################################

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

#################################################
# Editor / IDE noise (optional but recommended)
#################################################

.vscode/
.idea/
*.suo
*.user
*.userprefs
